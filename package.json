{
  "name": "coster",
  "version": "1.0.3",
  "description": "Universal context persistence layer for AI coding assistants",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "coster": "./bin/cli.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "keywords": [
    "ai",
    "coding",
    "context",
    "persistence",
    "mcp",
    "claude",
    "cursor",
    "copilot",
    "memory"
  ],
  "author": "Coster Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/savai15/coster.git"
  },
  "homepage": "https://github.com/savai15/coster#readme",
  "bugs": {
    "url": "https://github.com/savai15/coster/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "zod": "^3.25.76"
    },
    "zod-to-json-schema": {
      "zod": "^3.25.76"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^14.0.3",
    "sql.js": "^1.11.0",
    "uuid": "^11.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@vitest/coverage-v8": "^2.1.1",
    "prettier": "^3.3.3",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
